{
  "name": "@josh803316/shared-ci-workflows",
  "version": "1.0.0",
  "description": "Reusable CI workflows and tooling for @josh803316 projects",
  "type": "module",
  "bin": {
    "env-config": "bin/env-config.ts",
    "workflow-vercel": "bin/workflow-vercel.ts",
    "workflow-linear": "bin/workflow-linear.ts"
  },
  "scripts": {
    "prepare": "husky",
    "compile": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "env-config": "bun bin/env-config.ts"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@josh803316/shared-config": "3.0.1",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "@josh803316/shared-config",
    "esbuild",
    "sharp"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/josh803316/shared-ci-workflows.git"
  },
  "engines": {
    "npm": "****** PLEASE USE 'bun install', NPM IS NOT SUPPORTED ******"
  }
}
